<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.office-mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>exec "$HOME/.local/bin/uv" run --quiet --no-dev --project "$HOME/mcp-suite/servers/office" office-mcp --transport streamable-http</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OFFICE_MCP_HOST</key>
    <string>127.0.0.1</string>
    <key>OFFICE_MCP_PORT</key>
    <string>8769</string>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/office-mcp.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/office-mcp.log</string>
</dict>
</plist>
